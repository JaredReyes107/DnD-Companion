{
  "expo": {
    "name": "DnDCompanion",
    "slug": "DnDCompanion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/app-logo.jpeg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/app-logo.jpeg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jaredreyes.DnDCompanion"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/app-logo.jpeg"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d89c5706-eb0b-4988-beda-d41790cdeabd"
      }
    }
  }
}
